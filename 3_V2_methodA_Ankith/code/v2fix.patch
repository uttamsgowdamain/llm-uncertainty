+    def _agreement_step_u(self, batch_input: DataProto, active_masks: np.ndarray, actor_rollout_wg) -> np.ndarray:
+        """Method B (V3): agreement uncertainty for one step.
+
+        For every still-active environment, sample K extra responses for the same
+        prompt (same sampling settings as the executed action), and return
+        u = 1 - (count of most common action) / K per row. Inactive rows get 0;
+        they are dropped later by gather_rollout_data anyway. The executed action
+        is not one of the K samples.
+        """
+        k = int(self.config.algorithm.get("agreement_k", 5))
+        u = np.zeros(len(active_masks), dtype=np.float32)
+        idx = np.nonzero(np.asarray(active_masks, dtype=bool))[0]
+        if len(idx) == 0 or k < 1:
+            return u
+        sub = batch_input.select_idxs(idx).repeat(repeat_times=k, interleave=True)
+        sub.meta_info = batch_input.meta_info
+        sub_padded, pad_size = pad_dataproto_to_divisor(sub, actor_rollout_wg.world_size)
+        sub_out = unpad_dataproto(actor_rollout_wg.generate_sequences(sub_padded), pad_size=pad_size)
+        texts = self.tokenizer.batch_decode(sub_out.batch['responses'], skip_special_tokens=True)
+        for j, row in enumerate(idx):
+            u[row] = agreement_uncertainty(texts[j * k:(j + 1) * k])
+        return u
 
